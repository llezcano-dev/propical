{
  "name": "propical",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://propical.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/llezcano-dev/propical.git"
  },
  "bugs": {
    "url": "https://github.com/llezcano-dev/propical/issues"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:deep": "rm -rf .next node_modules node_modules/.cache && pnpm install",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "postinstall": "prisma generate",
    "build": "next build",
    "db:push": "tsx prisma/push-schema.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-test-user": "tsx prisma/seed-test-user.ts",
    "db:migrate-guest-form-pt": "tsx prisma/migrate-guest-form-pt.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "quality:knip": "knip",
    "quality:jscpd": "jscpd .",
    "quality:fallow": "fallow dead-code",
    "quality:audit": "pnpm audit --prod",
    "quality": "pnpm quality:knip; pnpm quality:jscpd; pnpm quality:fallow"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/nextjs": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fallow": "^3.17.0",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "prisma": "7.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "postcss": "8.5.23",
    "brace-expansion": "5.0.9",
    "minimatch": "10.0.3",
    "@hono/node-server": "1.19.15",
    "hono": "4.12.34",
    "valibot": "1.4.2",
    "deepmerge-ts": "8.0.0",
    "sharp": "0.35.3",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
