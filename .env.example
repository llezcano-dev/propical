# Copy this file to .env.local for local dev. Production env vars go in your
# hosting provider's dashboard (e.g. Vercel -> Settings -> Environment Variables).
# Keep your real values in .local/secrets/ — never commit .env files.
#
# This file is the single source of truth for EVERY env var the app can read.
# For each one:
#   [REQUIRED]   the app won't work correctly without it (generated locally or
#                obtained from an external provider).
#   [OPTIONAL]   safe to leave blank — the feature it enables is disabled.

# === Auth ===
# [REQUIRED] Signs session JWTs (HS256). Used in src/lib/auth.ts and
# src/middleware.ts. Without it the app falls back to a hardcoded insecure
# default and, in production, the middleware returns HTTP 500 ("JWT_SECRET not
# configured") for every protected route — login/session breaks.
# Generate: openssl rand -hex 32
# SECRET. Never prefix with NEXT_PUBLIC_, never commit it. Use a distinct value
# per environment (Production / Preview / Development).
JWT_SECRET=replace-with-strong-random-32-byte-hex-string

# === Cron ===
# [REQUIRED for calendar sync] Protects GET /api/calendar/cron — accepts
# ?secret=... or Authorization: Bearer <this>. An external scheduler
# (e.g. cron-job.org) hits this endpoint every 10 minutes. If left blank
# it falls back to JWT_SECRET (the app still works, but give it its own
# value). Distinct from JWT_SECRET.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-strong-random-32-byte-hex-string

# === Database ===
# [REQUIRED] The libSQL adapter supports both local SQLite and Turso (libSQL
# cloud). Pick one — the app auto-detects from these env vars.

# A) Local development (default — zero setup, just a file)
DATABASE_URL=file:./data/prod.db

# B) Production — Turso (libSQL cloud, serverless-friendly for Vercel).
#    Create a DB: turso db create propical
#    Get the URL:  turso db show propical --url
#    Get a token:  turso db tokens create propical
#    Leave A unset and set these instead.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# === Google OAuth (optional — enables "Continue with Google" + One Tap) ===
# [OPTIONAL] All three go together. If any is blank the Google sign-in button
# is hidden entirely (it's disabled when NEXT_PUBLIC_GOOGLE_CLIENT_ID is unset).
#
# -- Server-side (SECRET) --
# GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET drive the redirect flow:
# build the authorization URL and exchange the code for tokens.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   - OAuth 2.0 client type: Web application
#   - Authorized JavaScript origins: https://your-domain, http://localhost:3000
#   - Authorized redirect URIs: https://your-domain/api/auth/google/callback,
#                               http://localhost:3000/api/auth/google/callback
# The redirect URI is derived automatically (src/lib/google-oauth.ts), so it
# must match the app's origin exactly.
# Scopes used: openid, email, profile (basic, no verification needed).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -- Client-side (public) --
# [OPTIONAL] Same value as GOOGLE_OAUTH_CLIENT_ID. Baked into the client bundle
# at build time so the Sign-In button and One Tap know which client to use.
# Public by design (an OAuth Client ID is not a secret). Because it's baked at
# build time, changing it requires a redeploy.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === Error tracking (optional — Sentry) ===
# [OPTIONAL] Get a DSN at https://sentry.io — Settings -> Client Keys (DSN).
# Free tier: 5k errors/month. Leave blank to disable Sentry entirely.
# Public (it ships to the browser), so it's a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] Only used to upload source maps at build time (so stack traces
# show TypeScript, not minified JS). Does not affect runtime. Get it at
# Sentry -> Settings -> Auth Tokens -> "Create New Token" with project:releases.
# Leave blank to skip source-map uploads.
SENTRY_AUTH_TOKEN=

# === Transactional email (Resend) ===
# [REQUIRED for email-verified signup in PRODUCTION] Get a key at
# https://resend.com and verify your sending domain first.
#
# This looks optional ("email-verified signup") but in production it is
# effectively REQUIRED: the email-verification gate is always on when
# NODE_ENV === "production" (the dev bypass only applies outside production
# AND without a key). If you leave it blank, /api/auth/signup returns 502
# ("We couldn't send the verification email") and NO account is created.
#
# Resend does NOT allow free/public domains (gmail.com, outlook.com, yahoo.com)
# as the sender — you must own and verify a custom domain (e.g. propical.com.br).
#
# Verify the sender domain in Resend (Domains -> Add Domain) and paste the
# SPF/DKIM/DMARC records into your DNS host (registro.br) — the `from` address
# below must be on a verified domain or Resend rejects the send.
RESEND_API_KEY=
# Sender address — must be on a domain verified in your Resend account.
# Defaults to "Propical <no-reply@mail.propical.com.br>" when left blank.
# Format: "Name <addr@domain>". For testing without a verified domain you can
# temporarily use "onboarding@resend.dev" (only sends to your own account).
EMAIL_FROM=
